# Copy to .env (never commit it). Generate a secret with:
#   head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
SESSION_SECRET=
PORT=3000
# Number of reverse-proxy hops (Tailscale Funnel = 1)
TRUST_PROXY=1
# Set to false to test over plain http on your LAN; leave unset in production
# COOKIE_SECURE=false
# Optional: JSON file with {"percent":80,"charging":true} to show the phone's battery
# BATTERY_FILE=/data/battery.json
